{
  "name": "dsh-flash-director-ui",
  "version": "0.1.0",
  "description": "Flash 主控 · Pro 专家 预设的配置界面：复用 DSH 设置页编辑 expert-delegation.config.json（热加载覆盖，下次委派生效）与 agent.cordis.yml（基线，新开会话生效）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7 || ^0.1.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "js-yaml": "^4.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "agent-preset",
    "flash-director",
    "settings"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
